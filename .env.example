# 3DSCRIPT Engine — Environment Configuration
# Copy this to .env and fill in your API key

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use
GEMINI_MODEL=gemini-3.6-flash

# Scoring provider: gemini | mock
# Use "mock" for offline development (deterministic heuristic scorer, no API calls)
SCORER_PROVIDER=gemini

# Scene-to-scene 3D score movement below this value is flagged as a dead zone
DEAD_ZONE_THRESHOLD=1.5
